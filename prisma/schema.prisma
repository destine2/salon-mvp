// Salon MVP — Prisma schema
// Mirrors the data model in the PRD (section 9) for the management system:
// booking, payment-integrity checkout, and commission splitting.
// Provider: PostgreSQL (Supabase or Neon recommended for MVP — see README).

generator client {
  provider        = "prisma-client-js"
  // Lets src/lib/prisma.ts globally exclude Staff.passwordHash from every
  // query result in one place, instead of remembering a `select` at every
  // call site that touches Staff (appointments, reports, the staff list...).
  // Still "preview" in this Prisma version (5.22) despite being safe/stable
  // in practice — no schema/runtime behavior changes, just client typing.
  previewFeatures = ["omitApi"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Core tenant
// ---------------------------------------------------------------------------

model Salon {
  id        String   @id @default(cuid())
  name      String
  city      String?
  tier      SalonTier @default(FREE)
  // 0 = deposits disabled (default — every existing salon keeps today's
  // behavior: book straight to BOOKED, pay at checkout). Salon-level only,
  // not per-service — see the plan's "deposit defaults" wording.
  depositPercent Int @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  staff          Staff[]
  customers      Customer[]
  appointments   Appointment[]
  products       Product[]
  services       Service[]
  businessHours  BusinessHours[]

  // Phase 3: multi-branch support hangs off this same Salon model via a
  // future parentSalonId self-relation — deliberately left out of MVP scope.
}

enum SalonTier {
  FREE
  STARTER
  GROWTH
  MULTI_BRANCH
}

// ---------------------------------------------------------------------------
// People
// ---------------------------------------------------------------------------

model Staff {
  id            String     @id @default(cuid())
  salonId       String
  salon         Salon      @relation(fields: [salonId], references: [id])
  name          String
  phone         String     @unique // login identifier
  passwordHash  String?    // "salt:hash" via src/lib/password.ts — nullable only because it predates this column; every staff created going forward always has one
  role          StaffRole  @default(STYLIST)
  active        Boolean    @default(true) // deactivated staff keep their history but drop out of booking, dropdowns, and login — see src/app/api/staff/[id]/route.ts
  paystackSubaccountCode String? // set once the staff member's Paystack subaccount is created
  createdAt     DateTime   @default(now())

  commissionRule CommissionRule?
  appointments   Appointment[]
  transactionSplits TransactionSplit[]
}

enum StaffRole {
  OWNER
  STYLIST
  APPRENTICE
}

model CommissionRule {
  id              String   @id @default(cuid())
  staffId         String   @unique
  staff           Staff    @relation(fields: [staffId], references: [id])
  type            CommissionType @default(PERCENT)
  value           Decimal  @db.Decimal(10, 2) // percent (e.g. 40.00) or flat naira amount, depending on type
  isApprenticeStipend Boolean @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

enum CommissionType {
  PERCENT
  FLAT
  CHAIR_RENTAL
}

model Customer {
  id        String   @id @default(cuid())
  salonId   String
  salon     Salon    @relation(fields: [salonId], references: [id])
  name      String?
  phone     String   // WhatsApp-identified, not a created account
  createdAt DateTime @default(now())

  appointments Appointment[]

  @@unique([salonId, phone])
}

// ---------------------------------------------------------------------------
// Catalogue
// ---------------------------------------------------------------------------

/// Opening hours per weekday, in Lagos wall-clock minutes past midnight.
///
/// Minutes-as-integers rather than a `time` column: it sidesteps Prisma/Postgres
/// time-with-timezone ambiguity entirely, and the slot maths works in minutes
/// anyway (see src/lib/day-availability.ts).
///
/// A missing weekday row means CLOSED that day. A salon with no rows at all is
/// treated as not-yet-configured and falls back to 09:00–19:00, so adding this
/// table cannot silently close every existing salon.
model BusinessHours {
  id        String @id @default(cuid())
  salonId   String
  salon     Salon  @relation(fields: [salonId], references: [id], onDelete: Cascade)
  weekday   Int // 0 = Sunday .. 6 = Saturday, matching Date.getUTCDay()
  opensMin  Int
  closesMin Int

  @@unique([salonId, weekday])
}

model Service {
  id          String   @id @default(cuid())
  salonId     String
  salon       Salon    @relation(fields: [salonId], references: [id])
  name        String
  priceNaira  Decimal  @db.Decimal(10, 2)
  durationMin Int      @default(60)

  appointments Appointment[]
}

model Product {
  id                String   @id @default(cuid())
  salonId           String
  salon             Salon    @relation(fields: [salonId], references: [id])
  name              String
  stockQty          Int      @default(0)
  lowStockThreshold Int      @default(3)
  createdAt         DateTime @default(now())

  // Phase 2 — inventory tracking is out of MVP scope but modeled now
  // so checkout can optionally decrement stock later without a schema change.
}

// ---------------------------------------------------------------------------
// Booking
// ---------------------------------------------------------------------------

model Appointment {
  id         String   @id @default(cuid())
  salonId    String
  salon      Salon    @relation(fields: [salonId], references: [id])
  staffId    String
  staff      Staff    @relation(fields: [staffId], references: [id])
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id])
  serviceId  String
  service    Service  @relation(fields: [serviceId], references: [id])

  // @db.Timestamptz is required, not cosmetic: these are absolute instants
  // (computed via lib/lagos-time.ts), and the exclusion constraint in
  // prisma/sql/001_appointment_no_overlap.sql needs them as timestamptz to
  // avoid an implicit timestamp->timestamptz cast. That cast is STABLE, not
  // IMMUTABLE — it depends on the session's TimeZone setting — and Postgres
  // rejects any non-immutable function anywhere in an index expression,
  // including one inserted implicitly for a type mismatch. Discovered
  // applying this constraint against a live database; Prisma's default
  // DateTime mapping (bare `timestamp`, no tz) does not satisfy it.
  startTime  DateTime @db.Timestamptz(3)
  // Denormalized from startTime + service.durationMin at write time. It exists
  // so the database can enforce non-overlap directly: an exclusion constraint
  // needs a range, and a range needs an end. Every write path must set it —
  // see appointmentEndTime() in src/lib/overlap.ts.
  endTime    DateTime @db.Timestamptz(3)
  status     AppointmentStatus @default(BOOKED)
  isWalkIn   Boolean  @default(false)
  // Only set while status = HELD (a deposit-required public booking awaiting
  // payment). The sweep job (src/app/api/cron/release-expired-holds) cancels
  // any HELD appointment past this — see prisma/sql/001_appointment_no_overlap.sql
  // for why HELD still blocks the slot in the meantime.
  holdExpiresAt DateTime? @db.Timestamptz(3)

  // Reminder tracking (Phase 5) — set once each reminder actually sends, so
  // the reminder cron job never double-sends if it runs more than once.
  reminder24SentAt DateTime?
  reminder2SentAt  DateTime?

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  transaction Transaction?
  deposit     Deposit?

  @@index([staffId, startTime])
}

enum AppointmentStatus {
  // Deposit required, awaiting payment — see holdExpiresAt above. Never
  // reachable except via a deposit-enabled salon's public booking route;
  // always resolves to BOOKED (paid) or CANCELLED (hold expired) within
  // minutes, so it never lingers long enough to affect reconciliation.
  HELD
  BOOKED
  CONFIRMED
  COMPLETED
  NO_SHOW
  CANCELLED
}

// ---------------------------------------------------------------------------
// Payment integrity — the core differentiator (PRD section 5.2)
// ---------------------------------------------------------------------------

// A deposit paid at booking time to move an appointment HELD -> BOOKED.
// Kept separate from Transaction rather than reused: Transaction means "this
// checkout is settled" everywhere else in the app (reports, isFlagged,
// findIntegrityAnomalies all assume one Transaction = one completed
// checkout) — overloading it to also mean "a deposit toward an unfinished
// booking" would touch every reporting query. Collected as a plain,
// non-split Paystack charge to the salon's own account (see
// src/lib/paystack.ts#initializeTransaction) — never split via subaccount,
// because splitting a FLAT/CHAIR_RENTAL rule's fixed amount across two
// separate payments (deposit now, balance at checkout) does not sum to the
// same result as computing it once on the full price. The full commission
// split still happens exactly once, at final checkout, accounting for
// whatever was already collected here — see /api/transactions/route.ts.
model Deposit {
  id            String   @id @default(cuid())
  appointmentId String   @unique
  appointment   Appointment @relation(fields: [appointmentId], references: [id])

  amountNaira   Decimal  @db.Decimal(10, 2)
  status        DepositStatus @default(PENDING)
  paystackRef   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

enum DepositStatus {
  PENDING
  PAID
}

model Transaction {
  id            String   @id @default(cuid())
  appointmentId String   @unique
  appointment   Appointment @relation(fields: [appointmentId], references: [id])

  amountNaira   Decimal  @db.Decimal(10, 2)
  method        PaymentMethod
  paystackRef   String?  // set when method = CARD_TRANSFER and paid via Paystack
  isFlagged     Boolean  @default(false) // true if appointment was completed without a matching logged payment
  createdAt     DateTime @default(now())

  splits        TransactionSplit[]
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  CARD_TRANSFER // collected via Paystack in-app charge
}

// One row per party paid out of a transaction (owner + staff), so both the
// Paystack-split case (digital) and the manual-ledger case (cash) share the
// same reporting shape.
model TransactionSplit {
  id            String   @id @default(cuid())
  transactionId String
  transaction   Transaction @relation(fields: [transactionId], references: [id])
  staffId       String?
  staff         Staff?   @relation(fields: [staffId], references: [id])
  recipient     SplitRecipient
  amountNaira   Decimal  @db.Decimal(10, 2)
  settledViaPaystack Boolean @default(false)
}

enum SplitRecipient {
  OWNER
  STAFF
}
