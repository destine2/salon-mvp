# Database (Supabase or Neon — see README for setup)
DATABASE_URL="postgresql://user:password@host:5432/salon_mvp"

# Paystack (sandbox keys to start — https://dashboard.paystack.com/#/settings/developers)
PAYSTACK_SECRET_KEY="sk_test_xxxxxxxxxxxxxxxxxxxx"
PAYSTACK_PUBLIC_KEY="pk_test_xxxxxxxxxxxxxxxxxxxx"

# The subscription-billing Plan's code. Create it once with:
#   node --env-file=.env --import tsx -e "import('./src/lib/paystack').then(p => p.createPlan({name:'Salon MVP — Monthly', amountKobo: 1500000, interval: 'monthly'})).then(r => console.log(r.data.plan_code))"
# then paste the printed plan_code here. Also register this deployment's
# /api/webhooks/paystack URL in the Paystack dashboard's webhook settings —
# a real Paystack-initiated webhook can't reach localhost.
PAYSTACK_PLAN_CODE="PLN_xxxxxxxxxxxxxxxxxxxx"

# Termii (WhatsApp Cloud API + SMS fallback — https://termii.com)
TERMII_API_KEY="xxxxxxxxxxxxxxxxxxxx"
TERMII_SENDER_ID="SalonMVP"

# Used to sign/verify login session cookies (not passwords — those are
# hashed independently, see src/lib/password.ts)
AUTH_SECRET="replace-with-a-long-random-string"

# Used to build the Paystack callback URL (checkout/paystack-callback).
# Set this to your real domain once deployed.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Shared secret the scheduled GitHub Actions workflows (send-reminders,
# release-expired-holds) must present when calling their cron endpoints.
# Generate any random string, set the same value in Vercel's project
# settings AND as a GitHub repo secret (Settings → Secrets and variables →
# Actions) — see README's deploy checklist.
CRON_SECRET="replace-with-another-long-random-string"
