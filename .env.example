# Database (Supabase or Neon — see README for setup)
DATABASE_URL="postgresql://user:password@host:5432/salon_mvp"

# Paystack (sandbox keys to start — https://dashboard.paystack.com/#/settings/developers)
PAYSTACK_SECRET_KEY="sk_test_xxxxxxxxxxxxxxxxxxxx"
PAYSTACK_PUBLIC_KEY="pk_test_xxxxxxxxxxxxxxxxxxxx"

# Termii (WhatsApp Cloud API + SMS fallback — https://termii.com)
TERMII_API_KEY="xxxxxxxxxxxxxxxxxxxx"
TERMII_SENDER_ID="SalonMVP"

# Used to sign/verify login session cookies (not passwords — those are
# hashed independently, see src/lib/password.ts)
AUTH_SECRET="replace-with-a-long-random-string"

# Used to build the Paystack callback URL (checkout/paystack-callback).
# Set this to your real domain once deployed.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Shared secret the reminder cron job (vercel.json) must present. Generate
# any random string and set the same value in Vercel's project settings.
CRON_SECRET="replace-with-another-long-random-string"
